{
    "_hide": true,
    "description": "NERSC Perlmutter (CPU nodes) — HPE Cray EX (Slingshot); 2× AMD EPYC 7763, 128 cores",
    "scheduler": {
        "type": "slurm",
        "command": "sbatch",
        "default_queue": "regular",
        "default_args": ["-C cpu"],
        "queues": {
            "regular": { "min_nodes": 1,                  "max_walltime": "48:00:00", "default_walltime": "01:00:00" },
            "debug":   { "min_nodes": 1, "max_nodes": 8,  "max_walltime": "00:30:00", "default_walltime": "00:30:00" },
            "preempt": { "min_nodes": 1, "max_nodes": 128, "min_walltime": "02:00:00", "max_walltime": "48:00:00", "default_walltime": "02:00:00" }
        }
    },
    "launcher": {
        "type": "slurm",
        "command": "srun"
    },
    "hardware": {
        "cores_per_node": 128
    },
    "modules": ["PrgEnv-gnu"],
    "spack": {
        "packages": {
            "cray-mpich": {
                "externals": [
                    {
                        "spec": "cray-mpich@8.1.30",
                        "modules": ["cray-mpich/8.1.30"]
                    }
                ],
                "buildable": false
            },
            "libfabric": {
                "externals": [
                    {
                        "spec": "libfabric@1.22.0",
                        "modules": ["libfabric/1.22.0"]
                    }
                ],
                "buildable": false
            },
            "mpi": {
                "require": ["cray-mpich"]
            }
        }
    }
}
