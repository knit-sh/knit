{
    "description": "ORNL Frontier — HPE Cray EX, 64 cores + 8× AMD MI250X per node",
    "scheduler": {
        "type": "slurm",
        "command": "sbatch",
        "default_queue": "batch",
        "queues": {
            "batch":          { "max_walltime": "24:00:00", "max_nodes": 9408 },
            "debug":          { "max_walltime": "00:30:00", "max_nodes": 2 },
            "debug-scaling":  { "max_walltime": "01:00:00", "max_nodes": 115 }
        }
    },
    "launcher": {
        "type": "mpich",
        "command": "srun"
    },
    "hardware": {
        "cores_per_node": 64,
        "gpus_per_node": 8
    }
}
